#!/bin/bash
# Sync dotfiles repo and ensure that dotfiles are tangled correctly afterward
GREEN='\033[1;32m'   # Bold Green
BLUE='\033[1;34m'    # Bold Blue
RED='\033[1;31m'     # Bold Red
CYAN='\033[1;36m'    # Bold Cyan
YELLOW='\033[1;33m'  # Bold Yellow
MAGENTA='\033[1;35m' # Bold Magenta
WHITE='\033[1;37m'   # Bold White
NC='\033[0m'         # No Color

# Navigate to the directory of this script (generally ~/.dotfiles/.bin)
cd "$(dirname "$(readlink -f "$0")")"
cd ..
DOTFILES_DIR="$(pwd)"

# Check for changes in the remote repo
echo -e "${GREEN}Checking for changes in the remote repo...${NC}"
git remote update

if [ "$(git status -uno | grep -o 'Your branch is behind')" ]; then
    if [ -n "$(git status -s)" ]; then
        # There are local changes
        echo -e "${CYAN}Local changes found. Stashing...${NC}"
        git stash push -m "sync-dotfiles: Before pulling changes from the remote repo"
    else
        # No local changes
        echo -e "${BLUE}No local changes found.${NC}"
    fi
    # Pull updates from the remote repo
    echo -e "${YELLOW}Pulling updates from the remote repo...${NC}"
    git pull origin master
    # Show changes after pulling
    echo -e "${MAGENTA}Changes after pulling updates:${NC}"
    git --no-pager log --pretty=oneline --abbrev-commit --color origin/master..HEAD
    # Check if there were local changes before pulling
    if [ -n "$(git stash list)" ]; then
        # There were local changes before pulling, apply stashed changes
        echo -e "${CYAN}Applying stashed changes...${NC}"
        git stash apply
    else
        # No stashed changes
        echo -e "${BLUE}No stashed changes found.${NC}"
    fi
else
    echo -e "${BLUE}No changes in the remote repo.${NC}"
fi

# Walk a single package directory and resolve any stow conflicts before
# stow itself runs. A "conflict" = a file stow would need to symlink into
# the target dir, but a real (non-symlink) file already sits there.
# $1 = package name, $2 = target directory (default: $HOME)
resolve_conflicts() {
    local pkg="$1"
    local target_dir="${2:-$HOME}"
    local pkg_path="$DOTFILES_DIR/$pkg"

    while IFS= read -r -d '' src <&3; do
        rel="${src#"$pkg_path"/}"
        target="$target_dir/$rel"

        # No conflict: target missing, or already a symlink (stow's own
        # link from a previous run, or pointing into this same package).
        if [ ! -e "$target" ] || [ -L "$target" ]; then
            continue
        fi

        echo -e "${RED}Conflict:${NC} ${WHITE}$target${NC} exists and is not a symlink."
        echo -e "${CYAN}--- Existing content: $target ---${NC}"
        cat "$target"
        echo -e "${CYAN}-----------------------------------${NC}"

        while true; do
            read -p "$(echo -e "${YELLOW}Keep existing (k) or overwrite with repo version (o)? [k/o]: ${NC}")" choice
            case "$choice" in
                [oO])
                    backup="${target}.bak.$(date +%Y%m%d%H%M%S)"
                    mv "$target" "$backup"
                    echo -e "${GREEN}Overwritten. Existing file backed up to $backup${NC}"
                    break
                    ;;
                [kK])
                    # Pull the existing (local) content into the repo file,
                    # then drop the original so stow can symlink it.
                    cp "$target" "$src"
                    rm "$target"
                    echo -e "${GREEN}Kept existing content. Repo file updated; $target will now be symlinked.${NC}"
                    break
                    ;;
                *)
                    echo -e "${RED}Please answer 'k' or 'o'.${NC}"
                    ;;
            esac
        done
    done 3< <(find "$pkg_path" -type f -print0)
}

# Ask user whether to run stow
read -p "Do you want to run stow to link new dotfiles? (y/n): " answer
if [ "$answer" == "y" ]; then
    echo -e "${BLUE}Scanning packages for conflicts...${NC}"

    # config/ package symlinks into ~/.config
    if [ -d "config" ]; then
        echo -e "${BLUE}Checking package: config (target: ~/.config)${NC}"
        resolve_conflicts "config" "$HOME/.config"
    fi

    # Other packages (e.g. zsh/) symlink into $HOME
    for entry in */; do
        pkg="${entry%/}"
        [ "$pkg" = "config" ] && continue
        echo -e "${BLUE}Checking package: $pkg${NC}"
        resolve_conflicts "$pkg" "$HOME"
    done

    echo -e "${GREEN}Running stow...${NC}"
    stow --target="$HOME/.config" config/ 2>/dev/null
    stow zsh/ 2>/dev/null
    echo -e "${GREEN}Stow completed successfully.${NC}"
else
    echo -e "${BLUE}Stow skipped.${NC}"
fi
